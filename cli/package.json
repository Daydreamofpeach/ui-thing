{
  "name": "ui-thing-cli",
  "version": "1.0.0",
  "description": "CLI tool for adding ui-thing components to your project",
  "main": "dist/index.js",
  "bin": {
    "ui-thing": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --format esm",
    "dev": "bun --watch index.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ui",
    "components",
    "vue",
    "nuxt",
    "tailwind",
    "cli"
  ],
  "author": "buildit",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
